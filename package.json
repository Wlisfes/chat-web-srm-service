{
    "name": "chat-web-srm-service",
    "version": "1.0.1",
    "description": "",
    "author": "Wlisfes",
    "private": true,
    "license": "UNLICENSED",
    "scripts": {
        "install": "node scripts/yarn-auth.cjs install --frozen-lockfile --check-files --ignore-scripts",
        "base:update": "node scripts/yarn-auth.cjs upgrade @wlisfes/chat-web-base-schema --latest",
        "build": "nest build",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.cjs\" \"scripts/**/*.cjs\" \".github/workflows/*.yml\"",
        "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.cjs\" \"scripts/**/*.cjs\" \".github/workflows/*.yml\"",
        "test": "yarn build && node --test test/*.test.cjs",
        "start": "node scripts/start-with-cluster-port.cjs start",
        "dev": "node scripts/start-with-cluster-port.cjs start --watch",
        "debug": "node scripts/start-with-cluster-port.cjs start --debug --watch",
        "start:prod": "node dist/main",
        "deploy": "node scripts/deploy-branch.cjs"
    },
    "dependencies": {
        "@faker-js/faker": "9.9.0",
        "@nestjs/common": "^11.0.1",
        "@nestjs/config": "^4.0.0",
        "@nestjs/core": "^11.0.1",
        "@nestjs/platform-express": "^11.0.1",
        "@nestjs/swagger": "11.4.6",
        "@nestjs/typeorm": "11.0.3",
        "@wlisfes/chat-web-base-schema": "1.6.104",
        "china-division": "2.7.0",
        "class-transformer": "0.5.1",
        "class-validator": "0.15.1",
        "dotenv": "^16.6.1",
        "express": "5.2.1",
        "js-yaml": "^4.1.0",
        "mysql2": "3.23.3",
        "nacos": "^2.6.0",
        "redis": "6.2.1",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1",
        "typeorm": "0.3.31"
    },
    "devDependencies": {
        "@nestjs/cli": "^11.0.0",
        "@types/express": "^5.0.0",
        "@types/node": "^24.0.0",
        "prettier": "^3.4.2",
        "source-map-support": "^0.5.21",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.7.3"
    }
}
